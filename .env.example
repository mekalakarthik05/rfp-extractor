# LLM Provider Keys
# Set your Gemini API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY="your-gemini-api-key-here"

# The chosen provider SDK 
LLM_PROVIDER="gemini"

# Model name 
MODEL_NAME="gemini-flash-latest"

# Optional chunking & retry configurations
MAX_CHUNK_SIZE="6000"
MAX_CHUNKS="8"
MAX_RETRIES="4"

